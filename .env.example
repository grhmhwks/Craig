# Copy this file to .env. Keep exactly one active provider assignment and edit
# this shared block rather than adding duplicate provider sections.
#
# Provider choices:
#   demo   deterministic retrieval presentation; no model request or secret
#   local  loopback OpenAI-compatible server, such as Ollama
#   cloudflare hosted Cloudflare Workers AI API (free daily allocation applies)
#   groq   hosted Groq OpenAI-compatible API (free-plan limits may apply)
#   openai remote OpenAI Chat Completions adapter
CRAIG_MODEL_PROVIDER=demo

# Required for local/cloudflare/groq/openai; ignored by demo. Use the exact
# model ID published by the selected provider.
CRAIG_MODEL=

# Local-provider endpoint and optional token. Ignored by remote providers.
CRAIG_MODEL_BASE_URL=http://127.0.0.1:11434/v1
CRAIG_MODEL_API_KEY=

# Cloudflare Workers AI credentials. Both are required only for cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Other remote-provider secrets. Only the selected provider's credential is
# used. Never commit a populated .env or expose a key in browser/frontend code.
GROQ_API_KEY=
OPENAI_API_KEY=

# Shared bounded model-request settings.
CRAIG_MODEL_TIMEOUT_SECONDS=120
CRAIG_MODEL_MAX_OUTPUT_TOKENS=2000
CRAIG_MODEL_MAX_RESPONSE_BYTES=1048576

# Optional path/ranking overrides. Generated data must remain outside content/.
# CRAIG_CONTENT_ROOT=content
# CRAIG_INDEX_PATH=.craig/index.sqlite3
# CRAIG_FRONTEND_DIST=app/frontend/dist
# CRAIG_EXPLANATION_BOOST=1.5

# To load a differently located environment file, set CRAIG_ENV_FILE in the
# launching process before starting CRAIG; do not set it inside that file.
