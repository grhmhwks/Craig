# CRAIG defaults to the deterministic local demonstration and sends no data to a model.
CRAIG_MODEL_PROVIDER=demo

# Optional path overrides. Generated data must remain outside content/.
# CRAIG_CONTENT_ROOT=content
# CRAIG_INDEX_PATH=.craig/index.sqlite3
# CRAIG_FRONTEND_DIST=app/frontend/dist

# Remote OpenAI configuration. Uncomment and supply values in .env or your shell.
# CRAIG_MODEL_PROVIDER=openai
# CRAIG_MODEL=your-model-id
# OPENAI_API_KEY=

# Loopback OpenAI-compatible local server configuration.
# CRAIG_MODEL_PROVIDER=local
# CRAIG_MODEL=your-local-model-id
# CRAIG_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# CRAIG_MODEL_API_KEY=

# Shared bounded model-request settings.
# CRAIG_MODEL_TIMEOUT_SECONDS=60
# CRAIG_MODEL_MAX_OUTPUT_TOKENS=2000
# CRAIG_MODEL_MAX_RESPONSE_BYTES=1048576
